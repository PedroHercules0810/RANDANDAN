# ===================================================================
# RANDANDAN - Variáveis de ambiente (NÃO COMMITAR / NÃO COMPARTILHAR)
# ===================================================================
# Este arquivo é lido por scripts/generate-env.mjs, que gera o
# src/environments/environment.ts usado pela aplicação.
# Em produção (AWS Amplify), configure estas MESMAS chaves no
# console do Amplify (App settings > Environment variables).

# AWS Cognito — User Pool
NG_APP_COGNITO_USER_POOL_ID=us-east-1_BlTSoVg3o

# AWS Cognito — App Client (público, tipo SPA)
NG_APP_COGNITO_USER_POOL_CLIENT_ID=libpqd631j320r1lvsgle974

# Domínio do Hosted UI do Cognito (sem https:// e sem barra final)
NG_APP_COGNITO_DOMAIN=us-east-1bltsovg3o.auth.us-east-1.amazoncognito.com

# URLs permitidas de callback/login (separadas por vírgula)
# Devem ser IDÊNTICAS às cadastradas no App Client do Cognito
# (App integration > App clients > Hosted UI > Allowed callback URLs)
NG_APP_OAUTH_REDIRECT_SIGN_IN=http://localhost:4200/login,https://randandan.pedrohercules.dengoso.web.ufersa.dev.br/login

# URLs de logout (separadas por vírgula)
# Deve ser IDÊNTICA às cadastradas em "Allowed sign-out URLs"
NG_APP_OAUTH_REDIRECT_SIGN_OUT=http://localhost:4200/,https://randandan.pedrohercules.dengoso.web.ufersa.dev.br/
