# ===================================================================
# RANDANDAN - Exemplo de variáveis de ambiente
# ===================================================================
# 1. Copie este arquivo:  cp .env.example .env
# 2. Preencha com os valores do seu User Pool do AWS Cognito.
# 3. O .env é ignorado pelo git — nunca o comite.
# 4. O Google Client Secret NUNCA vai aqui: ele é configurado
#    apenas no console do Cognito (provedor Google).
# 5. Em produção (AWS Amplify), configure estas chaves no console
#    do Amplify (App settings > Environment variables).

NG_APP_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NG_APP_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NG_APP_COGNITO_DOMAIN=seu-dominio.auth.us-east-1.amazoncognito.com
NG_APP_OAUTH_REDIRECT_SIGN_IN=http://localhost:4200/login,https://SEU-DOMINIO/login
NG_APP_OAUTH_REDIRECT_SIGN_OUT=http://localhost:4200/,https://SEU-DOMINIO/
